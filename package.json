{
  "name": "family-wallet",
  "version": "2.0.0",
  "private": true,
  "description": "Sổ thu chi gia đình — Google Apps Script + React (single-file build)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('gas/index.html','review.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "push": "npm run build && clasp push -f"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "react": "18.3.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/google-apps-script": "1.0.83",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "jsdom": "^29.1.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.4"
  }
}
